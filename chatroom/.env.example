# Agent Chat Room - Environment Configuration
# Copy this file to .env and fill in your values

# ===========================================
# REQUIRED
# ===========================================

# Google Gemini API Key
# Get your API key from: https://aistudio.google.com/app/apikey
# Calls use the Interactions API (@google/genai SDK) with store=false —
# nothing is retained server-side at Google. Required model access:
#   - gemini-3.8-flash (default agent turns, image understanding)
#   - gemini-3.5-flash-lite (search / URL-context tool calls)
#   - gemini-3.1-pro-preview (optional per-agent "deliberate" tier)
GEMINI_API_KEY=your_api_key_here

# ===========================================
# OPTIONAL
# ===========================================

# Server port (defaults to 3001)
# PORT=3001

# Tool layer: how agents invoke images, artifacts, search and URL reading.
#
#   tags       (default) Agents write [IMAGE: ...] in prose; the server
#              regex-parses it after the turn ends, so the result reaches the
#              NEXT speaker rather than the one who asked for it.
#   functions  Agents emit real function calls. The server executes them
#              mid-turn and hands the result back — including the generated
#              image itself — so an agent can react to what it actually made
#              inside its own message.
#
# 'functions' is the intended destination (MODERNIZATION_PLAN.md §2) but has
# not yet been exercised against the live API. Both paths ship; switch back if
# it misbehaves.
# TOOL_MODE=functions

# Server-side conversation state. THIS IS A PRIVACY TRADE, not a tuning knob.
#
#   false (default) Nothing is retained at Google. Every turn re-sends the
#                   system prompt and the windowed transcript, and
#                   usage.total_cached_tokens stays at zero — there is no
#                   chain for implicit caching to key on.
#   true            Each agent gets a server-side chain, so a turn sends only
#                   what is new since that agent last spoke, and repeated
#                   prefix tokens bill at roughly a tenth of fresh input.
#                   In exchange Google RETAINS the conversation: 55 days on
#                   the paid tier, 1 day on free, configurable to 7/14/28/55
#                   in AI Studio. Resetting the room deletes the chains.
#
# Explicit caching is not available in the Interactions API at all — implicit
# caching via chaining is the only route, which is why this flag exists.
# GEMINI_STORE_INTERACTIONS=true

# File Search (RAG) for uploaded reference documents.
#
#   off (default) A PDF is base64-inlined on the first couple of turns and
#                 then never again; a text file is truncated at 5,000
#                 characters and pasted into the prompt. Anything past the
#                 cutoff is simply lost.
#   true          Documents are uploaded and indexed ONCE into a per-session
#                 store, and turns carry only the chunks a query retrieves,
#                 with citations. Images deliberately stay inline — an agent
#                 asked about a reference image needs to see it.
#
# Costs embedding tokens to index (storage and query embeddings are free) and
# creates remote state against a project-wide quota (1 GB free, 10 GB tier 1).
# Stores are deleted on reset; GET /api/chat/file-search/orphans lists any a
# crash left behind, and DELETE on the same path clears them.
# FILE_SEARCH=true

# Smart orchestration: let a cheap model answer the two questions the
# orchestrator currently answers with substring matching —
#   - who should speak next (currently: scanning for "Name," / "Name?")
#   - has the room finished (currently: a fixed list of phrases like
#     "that's a wrap" and "mission accomplished")
#
# This AUGMENTS the heuristics rather than replacing them. The fairness floor,
# the post-user cooldown and the consensus quorum are policy learned from real
# sessions and still win every time; the model only chooses between options
# the heuristics already accept. Any failure, timeout or low-confidence answer
# falls back to the heuristic that ships today.
#
# Costs one gemini-3.5-flash-lite call per turn ($0.30/$2.50 per 1M) and adds
# a round trip. Spend is reported separately as judgeUsage on session state.
# SMART_ORCHESTRATION=true

# Deep Research agent. ⚠ THIS ONE COSTS REAL MONEY: $1-3 per task, $3-7 in
# thorough mode. Tasks run for several minutes in the background; the report
# is delivered to whoever is speaking when it lands.
#
# This does NOT change the existing [RESEARCH:] tag, which stays the cheap
# search+URL path. Deep research is a separate `deep_research` function tool,
# available only in the 'researcher' tool tier, so an agent holds it only if
# someone decided it should.
#
# The per-session cap is enforced server-side, not by asking the model
# nicely. Raise it deliberately.
# DEEP_RESEARCH=true
# DEEP_RESEARCH_MAX_TASKS=2
