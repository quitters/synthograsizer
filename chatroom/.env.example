# Agent Chat Room - Environment Configuration
# Copy this file to .env and fill in your values

# ===========================================
# REQUIRED
# ===========================================

# Google Gemini API Key
# Get your API key from: https://aistudio.google.com/app/apikey
# Calls use the Interactions API (@google/genai SDK) with store=false —
# nothing is retained server-side at Google. Required model access:
#   - gemini-3.8-flash (default agent turns, image understanding)
#   - gemini-3.5-flash-lite (search / URL-context tool calls)
#   - gemini-3.1-pro-preview (optional per-agent "deliberate" tier)
GEMINI_API_KEY=your_api_key_here

# ===========================================
# OPTIONAL
# ===========================================

# Server port (defaults to 3001)
# PORT=3001

# Tool layer: how agents invoke images, artifacts, search and URL reading.
#
#   tags       (default) Agents write [IMAGE: ...] in prose; the server
#              regex-parses it after the turn ends, so the result reaches the
#              NEXT speaker rather than the one who asked for it.
#   functions  Agents emit real function calls. The server executes them
#              mid-turn and hands the result back — including the generated
#              image itself — so an agent can react to what it actually made
#              inside its own message.
#
# 'functions' is the intended destination (MODERNIZATION_PLAN.md §2) but has
# not yet been exercised against the live API. Both paths ship; switch back if
# it misbehaves.
# TOOL_MODE=functions
