      },
      "shape_count": {
        "widget": "slider",
        "hint": "Density of geometric forms on the poster"
      },
      "slide_speed": {
        "widget": "knob",
        "hint": "Speed of transitions between arrangements"
      },
      "beat_sensitivity": {
        "widget": "knob",
        "hint": "Likelihood of shapes shifting on each musical beat"
      },
      "ink_blend": {
        "widget": "buttons",
        "hint": "Layer blending style for overlapping shapes"
      }
    },
    "mobile": {
      "density": "roomy"
    },
    "desktop": {
      "columns": 3
    }
