    {
      "name": "theme",
      "label": "Machine Style",
      "values": [
        {
          "text": "brass clockwork",
          "weight": 2
        },
        {
          "text": "neon pachinko",
          "weight": 2
        },
        {
          "text": "cosmic arcade",
          "weight": 1
        },
        {
          "text": "slate minimalism",
          "weight": 1
        }
      ]
    },
    {
      "name": "peg_layout",
      "label": "Peg Pattern",
      "values": [
        {
          "text": "triangular pyramid",
          "weight": 2
        },
        {
          "text": "diamond lattice",
          "weight": 2
        },
        {
          "text": "funnel slalom",
          "weight": 1
        }
      ]
    },
    {
      "name": "bounciness",
      "label": "Elasticity",
      "type": "number",
      "min": 0.3,
      "max": 0.85,
      "step": 0.05,
      "default": 0.65
