      "label": "Flush Trapdoor",
      "type": "trigger",
      "share": "one"
    },
    {
      "name": "tilt",
      "label": "Board Tilt",
      "type": "number",
      "min": -25,
      "max": 25,
      "step": 1,
      "default": 0
