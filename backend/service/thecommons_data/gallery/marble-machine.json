      "peg_layout": {
        "widget": "buttons",
        "hint": ""
      },
      "bounciness": {
        "widget": "slider",
        "hint": "Impact springiness off pegs and walls"
      },
      "bin_count": {
        "widget": "stepper",
        "hint": "Number of sorting bins at the bottom"
      }
    },
    "mobile": {
      "density": "compact"
    },
    "desktop": {
      "columns": 2
    }
  },
  "listing": {
    "section": "games",
    "blurb": "A marble machine: anyone can drop a marble that falls through a field of pegs with real bouncing physics, marbles knock into each other on the way down and pile up at the bottom in the colour of whoever dropped them, and one person tilts the whole board left and right",
