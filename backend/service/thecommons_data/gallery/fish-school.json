{
  "name": "Bioluminescent Shoal",
  "promptTemplate": "A synchronized school of {{school_size}} fish in {{water_mood}} waters with {{swim_style}} movement. Predator lurking: {{predator}}. Flowing currents: {{show_current}}.",
  "variables": [
    {
      "name": "school_size",
      "label": "Fish Count",
      "type": "number",
      "min": 60,
      "max": 180,
      "step": 20,
      "default": 120
    },
    {
      "name": "water_mood",
      "label": "Water Mood",
      "values": [
        {
          "text": "sunlit_shallows",
          "weight": 2
        },
        {
          "text": "deep_trench",
          "weight": 2
        },
        {
          "text": "twilight_reef",
          "weight": 2
        },
        {
          "text": "bioluminescent",
          "weight": 3
        }
      ]
    },
    {
      "name": "swim_style",
      "label": "Swim Style",
      "values": [
        {
          "text": "glide",
          "weight": 2
        },
        {
          "text": "darting",
          "weight": 2
        },
        {
          "text": "swirling",
          "weight": 2
        }
      ]
    },
    {
      "name": "predator",
      "label": "Predator",
      "type": "toggle",
      "default": false
    },
    {
      "name": "show_current",
      "label": "Current Lines",
      "type": "toggle",
      "default": true
