    {
      "name": "feed",
      "label": "Drop Food",
      "type": "trigger",
      "share": "all"
    }
  ],
  "ui": {
    "skin": "desk",
    "variant": "blue",
    "title": "Aquarium Shoal 1.0",
    "tagline": "Synchronized marine life and fluid dynamics simulator",
    "accent": "#6effca",
    "groups": [
      {
        "title": "Actions",
        "controls": [
          "feed",
          "predator"
        ]
      },
      {
        "title": "Shoal Dynamics",
        "controls": [
          "school_size",
          "swim_style"
        ]
      },
      {
        "title": "Environment",
        "controls": [
          "water_mood",
          "show_current"
        ]
      }
    ],
    "controls": {
      "school_size": {
        "widget": "stepper",
        "hint": "Adjusts population density in the water"
      },
      "water_mood": {
        "widget": "cycle",
        "hint": "Shifts depth, luminescence, and ambient color"
      },
      "swim_style": {
        "widget": "buttons",
        "hint": ""
      },
      "predator": {
        "widget": "lamp",
        "hint": "Unleashes a red predator hunting the school"
      },
      "show_current": {
        "widget": "switch",
        "hint": "Renders vector field streamlines"
      },
      "feed": {
        "widget": "pad",
        "hint": "Dispenses glowing food pellets into the tank"
      }
    },
    "mobile": {
      "density": "roomy"
    },
    "desktop": {
      "columns": 3
    }
  },
  "listing": {
    "section": "games",
    "blurb": "A school of fish swimming as one; a predator can be switched on or off, the water's current can be shown as faint lines or hidden, and anyone can drop food.",
    "prompt": "A school of fish swimming as one; a predator can be switched on or off, the water's current can be shown as faint lines or hidden, and anyone can drop food.",
