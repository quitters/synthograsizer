{
  "name": "Elementary Automata Scroll",
  "promptTemplate": "Elementary cellular automata in {{rule_pack}} mode with {{palette}} palette, cell size {{cell_size}}px, rounded by {{cell_roundness}}px, scrolling at {{scroll_speed}} rows/sec with {{audio_glitch}} reactivity",
  "variables": [
    {
      "name": "rule_pack",
      "label": "CA Rule Set",
      "values": [
