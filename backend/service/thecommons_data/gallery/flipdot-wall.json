  "listing": {
    "section": "demo",
    "blurb": "A mechanical flip-dot solenoid board snaps between matte black and high-voltage neon, turning individual discs along physical pivot axles into shifting waves and geometric scans.",
    "prompt": "A huge flip-dot display: a grid of round discs, black on one side and fluorescent yellow on the other, flipping with a visible rotation to form slowly morphing shapes, faces of light and scrolling waves, each disc turning a moment after its neighbour. Make it striking on a big projected wall in a dark room: a bold composition, rich colour against real blacks, depth, glow, and motion that reads from across the room. Keep a demoscener's economy: lookup tables and fixed-size buffers kept in room.state, low-resolution offscreen buffers for any per-pixel work, nothing allocated inside hot loops, a steady 60fps at 1920x1080, and compact, clearly named code.",
    "look": [
      "retro",
      "geometric",
      "light"
    ],
    "source": "lightworks/flipdot-wall~3"
  }
