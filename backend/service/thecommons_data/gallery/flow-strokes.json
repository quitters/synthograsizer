{
  "name": "Earthy Non-Overlapping Flow",
  "promptTemplate": "A flow-field painting in {{palette}} with scale {{field_scale}}, drift {{flow_speed}}, {{stroke_density}} tracers, and decay {{decay_rate}}.",
