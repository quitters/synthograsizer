  "listing": {
    "section": "generative",
    "blurb": "A towering stack of cathode-ray televisions breaks and rolls a live video synthesizer signal into pulsing phosphor mosaics across the room.",
    "prompt": "A video wall in the manner of Nam June Paik: a stacked grid of mismatched cathode-ray televisions, each showing a fragment of one larger image that breaks apart, rolls, colour-shifts and reassembles in time with the music, scanlines and curved glass on every set. Make it striking on a big projected wall in a dark room: a bold composition, rich colour against real blacks, depth, glow, and motion that reads from across the room. Keep a demoscener's economy: lookup tables and fixed-size buffers kept in room.state, low-resolution offscreen buffers for any per-pixel work, nothing allocated inside hot loops, a steady 60fps at 1920x1080, and compact, clearly named code.",
    "look": [
      "retro",
      "light",
      "psychedelic"
    ],
    "source": "lightworks/video-wall~12"
  }
